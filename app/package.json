{
  "name": "pocketlm",
  "version": "1.0.0",
  "description": "Experimental on-device language model app for iOS",
  "private": true,
  "license": "UNLICENSED",
  "author": "PocketLM contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASDFGHJKLZXC123/pocketlm.git"
  },
  "homepage": "https://github.com/ASDFGHJKLZXC123/pocketlm#readme",
  "keywords": [
    "ios",
    "react-native",
    "llama.cpp",
    "on-device-llm"
  ],
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": "22.23.1"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "dependencies": {
    "@expo/log-box": "~55.0.10",
    "@expo/metro-runtime": "~55.0.9",
    "@sentry/react-native": "~8.8.0",
    "expo": "55.0.15",
    "expo-constants": "~55.0.14",
    "expo-file-system": "~55.0.16",
    "expo-linking": "~55.0.13",
    "expo-modules-core": "~55.0.22",
    "expo-router": "55.0.12",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "~4.3.1",
    "react-native-nitro-modules": "~0.35.4",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/runtime": "^7.29.2",
    "@types/react": "~19.2.0",
    "@types/react-native": "~0.73.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~55.0.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "typescript": "~5.8.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "clearMocks": true
  },
  "codegenConfig": {
    "name": "PocketLMSpec",
    "type": "modules",
    "jsSrcsDir": "src/lib",
    "android": {
      "javaPackageName": "com.pocketlm"
    }
  }
}
